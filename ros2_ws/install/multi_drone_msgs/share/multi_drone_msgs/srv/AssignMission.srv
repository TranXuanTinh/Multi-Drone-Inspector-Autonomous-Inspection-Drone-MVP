# ============================================================
# AssignMission.srv — Assign a mission to a specific vehicle
# ============================================================

# Request
uint8 vehicle_id
string mission_type         # "inspection", "patrol", "hover", "goto"
float64[] waypoint_lats     # Latitude array
float64[] waypoint_lons     # Longitude array
float32[] waypoint_alts     # Altitude array
float32 speed_ms            # Max mission speed
---
# Response
bool success
string message
uint32 num_waypoints_accepted
