<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_controller</name>
  <version>0.1.0</version>
  <description>
    Per-vehicle C++ ROS 2 node for PX4 offboard control via Micro XRCE-DDS.
    Handles arming, takeoff, offboard position/velocity setpoints,
    telemetry monitoring, and per-vehicle safety guards.
  </description>
  <maintainer email="developer@multidrone.dev">MultiDrone Developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>multi_drone_msgs</depend>
  <depend>eigen</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
